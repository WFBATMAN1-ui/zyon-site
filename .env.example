# Vigia — servidor e integrações locais
PORT=3000
NODE_ENV=development
DATA_DIR=.data
PUBLIC_ORIGIN=http://localhost:3000

# Lojas autorizadas para verificações HTTPS. Separa domínios por vírgulas.
STORE_ALLOWLIST=amazon.es,fnac.pt,nike.com,elcorteingles.es,apple.com,ryanair.com
MIN_STORE_DELAY_SECONDS=60
CRAWLER_USER_AGENT=VigiaPriceMonitor/1.0 (contacto: teu-email@exemplo.pt)

# Telegram: cria o bot com @BotFather. Nunca publiques este token.
TELEGRAM_BOT_TOKEN=

# Discord: URL de um webhook de entrada num canal teu. Mantém privado.
DISCORD_WEBHOOK_URL=

# Email de recuperação de palavra-passe (Resend).
RESEND_API_KEY=
MAIL_FROM=Vigia <noreply@teu-dominio.pt>

# Deixa false para manter só a primeira conta. Liga apenas se quiseres registo público.
ALLOW_SIGNUPS=false
